#!/bin/sh
# Run from the selected checkout, including a linked worktree.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if [ -L "$root/.venv" ] || [ -L "$root/.ci" ]; then
  echo 'CI requires checkout-owned .venv and .ci directories, not symlinks.' >&2
  exit 1
fi
if [ -x "$root/.venv/bin/python" ]; then
  exec "$root/.venv/bin/python" "$root/scripts/ci/run.py" "$@"
fi
exec python3 "$root/scripts/ci/run.py" "$@"
